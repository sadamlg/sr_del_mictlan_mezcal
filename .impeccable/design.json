  "components": [
    {
      "name": "Account Primary Action",
      "kind": "button",
      "refersTo": "account-primary",
      "description": "Acción principal en inicio de sesión, perfil y age-gate.",
      "html": "<button class=\"ds-btn-primary\">Entrar a mi cuenta</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 20px;border:1px solid color-mix(in srgb,var(--mictlan-teal) 35%,transparent);background:var(--mictlan-teal-deep);color:var(--mictlan-bone);font:600 12px Montserrat,sans-serif;letter-spacing:.16em;text-transform:uppercase;transition:background-color 200ms ease-out}.ds-btn-primary:hover{background:var(--mictlan-teal-hover)}.ds-btn-primary:focus-visible{outline:2px solid var(--mictlan-teal);outline-offset:4px}.ds-btn-primary:disabled{opacity:.6}"
    },
    {
      "name": "Hero Collection Action",
      "kind": "button",
      "refersTo": "hero-action",
      "description": "Enlace de alto contraste superpuesto a la fotografía principal.",
      "html": "<a class=\"ds-btn-hero\" href=\"#coleccion\">Conocer la colección</a>",
      "css": ".ds-btn-hero{position:relative;display:inline-flex;align-items:center;justify-content:center;padding:15.6px 41.6px;color:var(--mictlan-bone);font:600 13px \"Open Sans\",sans-serif;letter-spacing:.1em;text-transform:uppercase;text-decoration:none}.ds-btn-hero:before{position:absolute;inset:0;z-index:-1;content:\"\";background:var(--mictlan-green);clip-path:polygon(0 0,100% 0,100% 100%,10% 100%,0 75%);transition:background-color 300ms ease-out,transform 300ms ease-out}.ds-btn-hero:hover:before{background:color-mix(in srgb,var(--mictlan-green) 90%,transparent);transform:scale(1.1)}.ds-btn-hero:focus-visible{outline:2px solid var(--mictlan-teal);outline-offset:4px}"
    },
    {
      "name": "Account Field",
      "kind": "input",
      "refersTo": "account-field",
      "description": "Campo de formulario oscuro con foco teal y etiqueta arena.",
      "html": "<label class=\"ds-field-label\" for=\"email\">Correo electrónico</label><input class=\"ds-field\" id=\"email\" type=\"email\" placeholder=\"nombre@ejemplo.com\">",
      "css": ".ds-field-label{display:block;color:var(--mictlan-sand);font:500 12px Montserrat,sans-serif;letter-spacing:.03em}.ds-field{display:block;width:100%;margin-top:8px;padding:12px 14px;border:1px solid color-mix(in srgb,var(--mictlan-sand) 20%,transparent);border-radius:2px;background:color-mix(in srgb,var(--mictlan-carbon) 30%,transparent);color:var(--mictlan-ivory);font:400 14px \"Open Sans\",sans-serif}.ds-field::placeholder{color:var(--mictlan-earth-muted)}.ds-field:focus{border-color:var(--mictlan-teal);outline:2px solid var(--mictlan-teal);outline-offset:3px}"
    },
    {
      "name": "Account Card",
      "kind": "card",
      "refersTo": "account-card",
      "description": "Contenedor sobrio para formularios y datos personales.",
      "html": "<section class=\"ds-account-card\"><h2>Mi información</h2><p>Mantén tus datos al día.</p></section>",
      "css": ".ds-account-card{padding:24px;border:1px solid color-mix(in srgb,var(--mictlan-teal) 25%,transparent);background:color-mix(in srgb,var(--mictlan-background) 90%,transparent);color:var(--mictlan-ivory);box-shadow:0 24px 70px rgba(0,0,0,.32)}.ds-account-card h2{margin:0;font:400 28px \"Cinzel Decorative\",Georgia,serif}.ds-account-card p{color:var(--mictlan-sage-muted);font:400 14px/1.6 \"Open Sans\",sans-serif}"
    },
    {
