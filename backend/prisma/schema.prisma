generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "mts"
  importFileExtension    = "mts"
}

datasource db {
  provider = "postgresql"
}

enum AccountTokenPurpose {
  ACCOUNT_CONFIRMATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum EmailJobType {
  ACCOUNT_CONFIRMATION
  PASSWORD_RESET
  EMAIL_CHANGE_CONFIRMATION
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  FAILED
}

model Account {
  id              String           @id @default(uuid()) @db.Uuid
  firstName       String           @map("first_name") @db.VarChar(120)
  lastName        String           @map("last_name") @db.VarChar(120)
  email           String           @unique @db.VarChar(254)
  pendingEmail    String?          @unique @map("pending_email") @db.VarChar(254)
  passwordHash    String           @map("password_hash") @db.VarChar(220)
  dateOfBirth     DateTime         @map("date_of_birth") @db.Date
  street          String           @db.VarChar(120)
  number          String           @db.VarChar(120)
  neighborhood    String           @db.VarChar(120)
  locality        String           @db.VarChar(120)
  state           String           @db.VarChar(120)
  postalCode      String           @map("postal_code") @db.VarChar(5)
  emailVerifiedAt DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions        AccountSession[]
  tokens          AccountToken[]
  emailJobs       EmailJob[]

  @@map("accounts")
}

model AccountSession {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("account_sessions")
}

model AccountToken {
  id        String              @id @default(uuid()) @db.Uuid
  accountId String              @map("account_id") @db.Uuid
  purpose   AccountTokenPurpose
  tokenHash String              @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?          @map("consumed_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, expiresAt])
  @@map("account_tokens")
}

model EmailJob {
  id            String        @id @default(uuid()) @db.Uuid
  accountId     String        @map("account_id") @db.Uuid
  type          EmailJobType
  status        EmailJobStatus @default(PENDING)
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt      DateTime?     @map("locked_at") @db.Timestamptz(6)
  sentAt        DateTime?     @map("sent_at") @db.Timestamptz(6)
  lastError     String?       @map("last_error") @db.VarChar(120)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@map("email_jobs")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique @db.VarChar(80)
  name              String?  @db.VarChar(120)
  description       String?  @db.Text
  priceCents        Int?     @map("price_cents")
  imageKey          String?  @map("image_key") @db.VarChar(512)
  imageAlt          String?  @map("image_alt") @db.VarChar(240)
  lifestyleImageKey String?  @map("lifestyle_image_key") @db.VarChar(512)
  labelOne          String?  @map("label_one") @db.VarChar(80)
  labelTwo          String?  @map("label_two") @db.VarChar(80)
  sensoryProfile    String?  @map("sensory_profile") @db.Text
  alcoholMinPercent Float?   @map("alcohol_min_percent")
  alcoholMaxPercent Float?   @map("alcohol_max_percent")
  volumeMl          Int?     @map("volume_ml")
  position          Int      @default(0)
  active            Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, position, slug])
  @@map("products")
}

model SiteVisit {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("site_visits")
}

model SiteVisitCounter {
  id         Int      @id @default(1) @db.SmallInt
  visitCount BigInt   @default(0) @map("visit_count")

  @@map("site_visit_counter")
}
