# Base local de Docker Compose. Copia este archivo como .env.
COMPOSE_PROJECT_NAME=sr-del-mictlan-mezcal

POSTGRES_DB=mictlan_dev
POSTGRES_USER=mictlan_dev
POSTGRES_PASSWORD=postgres_local_only
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=4000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_PORT=8025

# Direcciones internas y públicas del desarrollo local.
INTERNAL_API_URL=http://backend:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
MEDIA_BASE_URL=http://localhost:3000
# Si usas una IP LAN, actualiza también los orígenes públicos. Ver docs/development.md.
NEXT_ALLOWED_DEV_ORIGIN=
FRONTEND_ORIGIN=http://localhost:3000
# Los enlaces de correo deben apuntar al mismo frontend público del entorno.
APP_BASE_URL=http://localhost:3000

# Opcional: Stripe en modo de prueba. El secreto whsec_ lo entrega stripe listen.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: origen HTTPS público para imágenes dentro de Stripe Checkout.
STRIPE_MEDIA_BASE_URL=

# Mailpit local; Resend se configura sólo en el worker desplegado.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=noreply@senordelmictlan.local
